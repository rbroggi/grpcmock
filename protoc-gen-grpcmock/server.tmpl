// StartGRPCMockServer initializes and starts the gRPC mock server and its HTTP control plane.
func StartGRPCMockServer(grpcPort, httpPort string) (grpcShutdown func(), httpCtrlShutdown func()) {
	// Initialize runtime services
	globalStore = storage.NewInMemoryStore()
	globalMatcher = matching.NewService(globalStore)
	globalUnaryHandler = grpchandler.NewUnaryHandler(globalMatcher, globalStore)
	globalStreamHandler = grpchandler.NewStreamHandler(globalMatcher, globalStore)

	// Start gRPC server
	lis, err := net.Listen("tcp", fmt.Sprintf(":%s", grpcPort))
	if err != nil {
		log.Fatalf("grpcmock-server: Failed to listen on gRPC port %s: %v", grpcPort, err)
	}

	grpcServer := grpc.NewServer()
	{{range .Services}}
	{{.QualifiedRegisterServerFuncName}}(grpcServer, New{{.MockServerStructName}}())
	{{end}}

	log.Printf("grpcmock-server: gRPC server starting on port %s", grpcPort)
	go func() {
		if serveErr := grpcServer.Serve(lis); serveErr != nil && !errors.Is(serveErr, grpc.ErrServerStopped) {
			log.Fatalf("grpcmock-server: Failed to serve gRPC: %v", serveErr)
		}
	}()

	grpcShutdown = func() {
		log.Println("grpcmock-server: Shutting down gRPC server...")
		grpcServer.GracefulStop()
		log.Println("grpcmock-server: gRPC server stopped.")
	}

	// Start HTTP control server using the new httphandler package
	// The StartHTTPServer function now takes the composite store interface from httphandler.
	// We need to ensure globalStore (which is storage.Store) satisfies this.
	// This requires storage.Store to be comprehensive enough or httphandler.store to be adjusted.
	// For now, assume globalStore can be directly used if it implements all needed methods.
	// The httphandler.StartHTTPServer expects a 'httphandler.store' which embeds expectationStore and verificationStore.
	// Our globalStore (type storage.Store) should implement these.
	_, httpCtrlShutdown = httph.StartHTTPServer(httpPort, globalStore)

	log.Printf("grpcmock-server: Mock server started. gRPC on :%s, HTTP control on :%s. Press Ctrl+C to exit.", grpcPort, httpPort)
	return grpcShutdown, httpCtrlShutdown
}

// listenForShutdownSignal waits for OS signals for graceful shutdown.
func listenForShutdownSignal(shutdownFuncs ...func()) {
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit
	log.Println("grpcmock-server: Shutdown signal received...")
	for _, sf := range shutdownFuncs {
		sf()
	}
}

// main function for the generated server.
func main() {
	var grpcPortFlag, httpPortFlag string

	defaultGRPCPort := "{{.GRPCPort}}" // These are string literals from template data
	defaultHTTPPort := "{{.HTTPPort}}"

	envGRPCPort := os.Getenv("GRPCMOCK_GRPC_PORT")
	if envGRPCPort != "" {
		defaultGRPCPort = envGRPCPort
	}
	envHTTPPort := os.Getenv("GRPCMOCK_HTTP_PORT")
	if envHTTPPort != "" {
		defaultHTTPPort = envHTTPPort
	}

	flag.StringVar(&grpcPortFlag, "grpc-port", defaultGRPCPort, "gRPC server port for the mock")
	flag.StringVar(&httpPortFlag, "http-port", defaultHTTPPort, "HTTP control server port for the mock")
	flag.Parse()

	grpcShutdown, httpShutdown := StartGRPCMockServer(grpcPortFlag, httpPortFlag)

	listenForShutdownSignal(httpShutdown, grpcShutdown) // Call http first, then grpc
	log.Println("grpcmock-server: All services shut down gracefully.")
}

